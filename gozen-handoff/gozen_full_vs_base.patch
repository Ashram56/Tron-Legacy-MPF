+int64_t GoZenVideo::next_frame_held() {
+	if (!loaded)
+		return -1;
+	int64_t id = -1;
+	FFmpeg::get_frame(av_format_ctx.get(), av_codec_ctx.get(), av_stream->index, av_frame.get(), av_packet.get());
+#ifdef __linux__
+	if (is_zero_copy())
+		id = zero_copy->hold(av_codec_ctx.get(), av_frame.get(), decoder_generation);
+#endif
+	if (id < 0)
+		_copy_frame_data();
+	current_frame++;
+	av_frame_unref(av_frame.get());
+	av_packet_unref(av_packet.get());
+	return id;
+}
