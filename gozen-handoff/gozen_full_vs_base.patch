index bf3796f..338bb97 100644
--- a/src/gozen_video.cpp
+++ b/src/gozen_video.cpp
@@ -1,4 +1,136 @@
 #include "gozen_video.hpp"
+#include "gozen_v4l2.h"
+
+#include <algorithm>
+#include <mutex>
+#include <string>
+
+
+// Windows hardware decoding (Direct3D 11 Video, else DXVA2: every GPU vendor, no extra library): one device for
+// every video, made on first use (FFmpeg locks it around each use), so opening a video does not make a device.
+static AVBufferRef* _hw_device(AVHWDeviceType type) {
+	static std::mutex mutex;
+	static AVBufferRef* devices[32] = {};
+	static bool failed[32] = {};
+	if ((int)type < 0 || (int)type >= 32)
+		return nullptr;
+	std::lock_guard<std::mutex> lock(mutex);
+	if (!devices[type] && !failed[type] && av_hwdevice_ctx_create(&devices[type], type, nullptr, nullptr, 0) < 0) {
+		devices[type] = nullptr;
+		failed[type] = true;
+		UtilityFunctions::print("GoZen: no ", av_hwdevice_get_type_name(type), " device on this PC");
+	}
+	return devices[type];
+}
+
+
+// FFmpeg asks for a pixel format when it meets the stream's parameters: the GPU's when it is offered, else the first
+// software one (FFmpeg offers software formats when the GPU cannot set itself up for this video).
+static enum AVPixelFormat _get_hw_format(AVCodecContext* ctx, const enum AVPixelFormat* formats) {
+	enum AVPixelFormat want = (enum AVPixelFormat)(intptr_t)ctx->opaque;
+	for (const enum AVPixelFormat* p = formats; *p != AV_PIX_FMT_NONE; p++)
+		if (*p == want)
+			return *p;
+	for (const enum AVPixelFormat* p = formats; *p != AV_PIX_FMT_NONE; p++) {
+		const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(*p);
+		if (desc && !(desc->flags & AV_PIX_FMT_FLAG_HWACCEL))
+			return *p;
+	}
+	return AV_PIX_FMT_NONE;
+}
+
+
+bool GoZenVideo::_open_hwaccel(const AVCodec* codec, AVHWDeviceType type) {
+	hw_pix_fmt = AV_PIX_FMT_NONE;
+	for (int i = 0;; i++) {
+		const AVCodecHWConfig* config = avcodec_get_hw_config(codec, i);
+		if (!config)
+			return false; // this decoder has no such hardware path in this FFmpeg
+		if ((config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) && config->device_type == type) {
+			hw_pix_fmt = config->pix_fmt;
+			break;
+		}
+	}
+	AVBufferRef* device = _hw_device(type);
+	if (!device) {
+		hw_pix_fmt = AV_PIX_FMT_NONE;
+		return false;
+	}
+	av_codec_ctx = make_unique_ffmpeg<AVCodecContext, AVCodecCtxDeleter>(avcodec_alloc_context3(codec));
+	if (av_codec_ctx == NULL || avcodec_parameters_to_context(av_codec_ctx.get(), av_stream->codecpar)) {
+		hw_pix_fmt = AV_PIX_FMT_NONE;
+		return false;
+	}
+	av_codec_ctx->hw_device_ctx = av_buffer_ref(device);
+	av_codec_ctx->opaque = (void*)(intptr_t)hw_pix_fmt;
+	av_codec_ctx->get_format = _get_hw_format;
+	av_codec_ctx->thread_count = 1; // the GPU decodes: one thread feeds it, and fewer frames are held in flight
+	if (avcodec_open2(av_codec_ctx.get(), codec, nullptr) != 0) {
+		hw_pix_fmt = AV_PIX_FMT_NONE;
+		return false;
+	}
+	return true;
+}
+
+
+// A frame the GPU decoded is copied to system memory (NV12 for 8-bit video) before _copy_frame_data() reads it.
+bool GoZenVideo::_hw_download() {
+	if (hw_pix_fmt == AV_PIX_FMT_NONE || av_frame->format != hw_pix_fmt)
+		return true;
+	if (!av_hw_frame)
+		av_hw_frame = make_unique_avframe();
+	av_frame_unref(av_hw_frame.get());
+	if (av_hwframe_transfer_data(av_hw_frame.get(), av_frame.get(), 0) < 0) {
+		_log_err("Couldn't copy the frame from the GPU");
+		return false;
+	}
+	av_frame_copy_props(av_hw_frame.get(), av_frame.get());
+	av_frame_unref(av_frame.get());
+	av_frame_move_ref(av_frame.get(), av_hw_frame.get());
+	return true;
+}
+
+
+bool GoZenVideo::_open_decoder(const AVCodec* codec, bool hw) {
+	av_codec_ctx = make_unique_ffmpeg<AVCodecContext, AVCodecCtxDeleter>(avcodec_alloc_context3(codec));
+	if (av_codec_ctx == NULL)
+		return false;
+	if (avcodec_parameters_to_context(av_codec_ctx.get(), av_stream->codecpar))
+		return false;
+	// FFmpeg's own tool sets these; the V4L2 M2M decoders convert pts to and from V4L2 timestamps with them, and
+	// without them every decoded frame comes back with AV_NOPTS_VALUE
+	if (String(codec->name).ends_with("_v4l2m2m")) {
+		av_codec_ctx->pkt_timebase = av_stream->time_base;
+		av_codec_ctx->time_base = av_stream->time_base;
+	}
+	FFmpeg::enable_multithreading(av_codec_ctx.get(), codec);
+	AVDictionary* codec_options = nullptr;
+	if (hw) {
+		// jetson-ffmpeg's nvmpi decoders: NV12 straight from the hardware (no conversion to YUV420P), and scaled down
+		// by the hardware (VIC) to the shown size, keeping the aspect (even sizes, never up)
+		av_dict_set(&codec_options, "output_format", "nv12", 0);
+		int w = av_stream->codecpar->width, h = av_stream->codecpar->height;
+		if (target_size.x > 0 && target_size.y > 0 && w > 0 && h > 0) {
+			double scale = std::min(1.0, std::min((double)target_size.x / w, (double)target_size.y / h));
+			int tw = std::max(2, (int)(w * scale + 1) & ~1), th = std::max(2, (int)(h * scale + 1) & ~1);
+			if (tw < w && th < h)
+				av_dict_set(&codec_options, "resize", (std::to_string(tw) + "x" + std::to_string(th)).c_str(), 0);
+		}
+	}
+	if (String(codec->name).ends_with("_v4l2m2m")) {
+		// 20 capture buffers by default; zero-copy imports each once. It holds up to 7: 12 leave the decoder 5.
+		String n = OS::get_singleton()->get_environment("GOZEN_V4L2_CAPTURE_BUFFERS");
+		av_dict_set(&codec_options, "num_capture_buffers", n.is_empty() ? "12" : n.utf8().get_data(), 0);
+		// NV12 (Y, then interleaved UV) rather than the stream's YUV420P: zero-copy imports and samples two planes
+		// per frame instead of three, and Mesa makes two tiled copies instead of three. FFmpeg asks the driver for
+		// pix_fmt first and falls back to the driver's own list. GOZEN_V4L2_PIXFMT=yuv420p keeps three planes.
+		if (OS::get_singleton()->get_environment("GOZEN_V4L2_PIXFMT") != "yuv420p")
+			av_codec_ctx->pix_fmt = AV_PIX_FMT_NV12;
+	}
+	bool ok = avcodec_open2(av_codec_ctx.get(), codec, &codec_options) == 0;
+	av_dict_free(&codec_options);
+	return ok;
+}
 
 
