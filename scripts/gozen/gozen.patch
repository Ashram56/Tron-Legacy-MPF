+bool GoZenVideo::_open_decoder(const AVCodec* codec, bool hw) {
+	av_codec_ctx = make_unique_ffmpeg<AVCodecContext, AVCodecCtxDeleter>(avcodec_alloc_context3(codec));
+	if (av_codec_ctx == NULL)
+		return false;
+	if (avcodec_parameters_to_context(av_codec_ctx.get(), av_stream->codecpar))
+		return false;
+	FFmpeg::enable_multithreading(av_codec_ctx.get(), codec);
+	AVDictionary* codec_options = nullptr;
+	if (hw) {
+		// jetson-ffmpeg's nvmpi decoders: NV12 straight from the hardware (no conversion to YUV420P), and scaled down
+		// by the hardware (VIC) to the shown size, keeping the aspect (even sizes, never up)
+		av_dict_set(&codec_options, "output_format", "nv12", 0);
+		int w = av_stream->codecpar->width, h = av_stream->codecpar->height;
+		if (target_size.x > 0 && target_size.y > 0 && w > 0 && h > 0) {
+			double scale = std::min(1.0, std::min((double)target_size.x / w, (double)target_size.y / h));
+			int tw = std::max(2, (int)(w * scale + 1) & ~1), th = std::max(2, (int)(h * scale + 1) & ~1);
+			if (tw < w && th < h)
+				av_dict_set(&codec_options, "resize", (std::to_string(tw) + "x" + std::to_string(th)).c_str(), 0);
+		}
+	}
+	bool ok = avcodec_open2(av_codec_ctx.get(), codec, &codec_options) == 0;
+	av_dict_free(&codec_options);
+	return ok;
+}
